PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
OPENAI_API_KEY=replace_with_your_openai_api_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis / BullMQ (use a Redis URL, including credentials/TLS options when hosted)
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genai_github

# Evaluation runner only; set these in your ignored backend/.env
EVAL_EMAIL=replace_with_your_eval_account_email
EVAL_PASSWORD=replace_with_your_eval_account_password
REPO_ID=replace_with_your_indexed_repo_id
INDEXED_COMMIT=replace_with_the_indexed_commit_sha
